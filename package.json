{
  "name": "court-rider",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:single-html": "node scripts/build-single-html.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify:contact": "node scripts/verify-contact-endpoint.mjs",
    "verify:translations": "node scripts/verify-translations.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:references": "node scripts/verify-references.mjs",
    "verify:routes": "node scripts/verify-preview-routes.mjs",
    "verify:deployed-routes": "node scripts/verify-deployed-routes.mjs",
    "verify:deployed-contact": "node scripts/verify-deployed-contact.mjs",
    "verify:deployed": "node scripts/verify-deployed-preview.mjs",
    "verify:deployed-contact-live": "node scripts/verify-deployed-contact-live.mjs",
    "release:check": "npm run build && npm run verify:contact && npm run verify:translations && npm run verify:security && npm run verify:assets && npm run verify:references"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
